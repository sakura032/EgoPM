{
  "schema_version": "bge_selection_policy_v3_1",
  "candidate_count": {
    "core_count": 10000,
    "minimum_count": 10000,
    "maximum_count": 12000,
    "extension_policy": "rare_cluster_novelty_round_robin_v1",
    "extension_cluster_soft_cap": 12,
    "extension_minimum_cosine_distance_gt": 0.08,
    "extension_next_count_allocation": "recompute_split_and_participant_largest_remainder_for_proposed_total_then_require_positive_delta_strata",
    "extension_modality_rule": "candidate_must_preserve_current_bounds_and_reachability_of_next_minimum",
    "extension_no_candidate_for_required_delta": "stop_at_previous_count",
    "stop_rule": "full_eligible_cluster_round_without_addition_or_maximum_count"
  },
  "eligibility": {
    "normalization": {
      "version": "nfkc_casefold_whitespace_cf_v1",
      "unicode_version": "15.0.0",
      "operation_order": [
        "unicode_nfkc",
        "default_casefold",
        "remove_general_category_cf",
        "map_python_str_isspace_true_to_ascii_space",
        "collapse_consecutive_ascii_spaces",
        "strip_ascii_space"
      ],
      "letter_or_number_test": "unicode_general_category_prefix_L_or_N",
      "model_input_use": "none_eligibility_and_audit_only",
      "test_vectors": [
        {
          "case_id": "nfkc_width",
          "input": "ＡＢＣ\t１２３",
          "normalized": "abc 123",
          "has_letter_or_number": true
        },
        {
          "case_id": "nbsp_and_casefold",
          "input": "  Café TEST  ",
          "normalized": "café test",
          "has_letter_or_number": true
        },
        {
          "case_id": "remove_cf",
          "input": "A‍B",
          "normalized": "ab",
          "has_letter_or_number": true
        },
        {
          "case_id": "collapse_whitespace",
          "input": "甲\n\t乙",
          "normalized": "甲 乙",
          "has_letter_or_number": true
        },
        {
          "case_id": "whitespace_only",
          "input": " \t\n ",
          "normalized": "",
          "has_letter_or_number": false
        },
        {
          "case_id": "punctuation_only",
          "input": "...！？",
          "normalized": "...!?",
          "has_letter_or_number": false
        }
      ]
    },
    "exclude_if_all_text_fields_empty": true,
    "exclude_if_normalized_text_has_no_letter_or_number": true,
    "encoded_source_fields": [
      "transcript",
      "dense_caption"
    ],
    "visible_text_role": "source_consistency_check_only_not_encoded_not_exported"
  },
  "retrieval": {
    "dense_top_k_per_query": 500,
    "sparse_top_k_per_query": 500,
    "rrf_k": 60,
    "rank_origin": 1,
    "score_dtype": "float32",
    "query_family_order": [
      "Object",
      "Person",
      "Activity",
      "Location",
      "State",
      "Explicit-Time"
    ],
    "channel_order": [
      "rrf",
      "dense_query",
      "sparse_query",
      "diversity"
    ],
    "family_quota_policy": "none_all_families_retrieved_and_reported_without_minimum_or_maximum"
  },
  "diversity": {
    "retrieval_embedding": {
      "dimension": 1024,
      "dtype": "float32",
      "l2_normalized": true,
      "use": "retrieval_and_exact_candidate_distance"
    },
    "exact_cosine_distance": {
      "backend": "numpy_cpu_single_thread",
      "input_dtype": "float32",
      "multiply_dtype": "float64",
      "sum_dtype": "float64",
      "sum_axis_order": "numpy_sum_last_axis_c_contiguous",
      "dot_clip_minimum": -1.0,
      "dot_clip_maximum": 1.0,
      "distance_formula": "numpy_float32_one_minus_clipped_dot",
      "comparison_dtype": "float32",
      "thread_count": 1
    },
    "clustering_projection": {
      "algorithm": "sklearn_sparse_random_projection_v1",
      "input_dimension": 1024,
      "output_dimension": 256,
      "density": 0.03125,
      "random_seed": 20260910,
      "output_dtype": "float32",
      "l2_normalize_after_projection": true,
      "use": "clustering_only"
    },
    "training_sample": {
      "count": 65536,
      "strata": [
        "split",
        "participant_source_id",
        "modality"
      ],
      "allocation": "eligible_share_largest_remainder_v1",
      "minimum_per_nonempty_stratum": 32,
      "stratum_shortfall_policy": "use_all_available",
      "aggregate_minimum_exceeds_sample_policy": "one_per_nonempty_stratum_then_residual_eligible_share_largest_remainder",
      "nonempty_strata_exceed_sample_count_policy": "block",
      "sample_order": "sha256_seed_nul_atom_id_ascending",
      "random_seed": 20260910
    },
    "clustering": {
      "algorithm": "sklearn_minibatch_kmeans_projected_unit_v1",
      "cluster_count": 1024,
      "batch_size": 8192,
      "init": "k-means++",
      "init_size": 8192,
      "n_init": 3,
      "max_iter": 20,
      "max_no_improvement": 30,
      "tol": 0.0,
      "reassignment_ratio": 0.0,
      "random_seed": 20260910,
      "training_thread_count": 1,
      "assignment_chunk_size": 16384,
      "distance_metric": "euclidean_on_l2_normalized_projected_vectors"
    },
    "canonical_cluster_id": {
      "version": "centroid_float32_le_sha256_ascending_v2",
      "dtype": "float32",
      "byte_order": "little_endian",
      "memory_order": "C",
      "canonicalize_negative_zero": true,
      "reject_nan_or_infinity": true,
      "sort_keys": [
        "centroid_sha256_ascending",
        "centroid_bytes_lexicographic_ascending"
      ],
      "duplicate_centroid_policy": "block_without_original_label_fallback",
      "id_format": "cluster_{zero_based_rank:04d}",
      "scope": "selection_snapshot_only"
    },
    "clustering_quality_gates": {
      "eligible_assignment_coverage_exact": 1.0,
      "empty_cluster_count_maximum": 0,
      "duplicate_centroid_count_maximum": 0,
      "report_metrics": [
        "training_inertia",
        "cluster_size_minimum",
        "cluster_size_median",
        "cluster_size_p95",
        "cluster_size_p99",
        "cluster_size_maximum",
        "cluster_occupancy_entropy"
      ]
    },
    "near_duplicate_cosine_distance_lte": 0.04,
    "near_duplicate_scope": "within_canonical_cluster_using_full_embedding",
    "near_duplicate_algorithm": "deterministic_greedy_survivor_v1",
    "near_duplicate_processing_order": [
      "source_group_eligible_count_ascending",
      "split_participant_modality_eligible_count_ascending",
      "outside_query_union_true_first",
      "rrf_score_descending",
      "best_dense_rank_ascending",
      "best_sparse_rank_ascending",
      "projected_euclidean_distance_to_centroid_ascending",
      "atom_id_ascending"
    ],
    "missing_rank_value": "positive_infinity",
    "suppression_rule": "suppress_current_if_distance_lte_threshold_to_any_earlier_survivor",
    "minimum_per_nonempty_cluster": 1,
    "maximum_per_cluster": 20,
    "diversity_reservoir_per_cluster": 64,
    "diversity_reservoir_construction": "centroid_first_then_full_embedding_farthest_first_v1",
    "core_minimum_selected_from_diversity_reservoir": 3500,
    "core_minimum_selected_from_diversity_reservoir_outside_query_union": 2000,
    "rare_cluster_order": "eligible_cluster_size_ascending_then_cluster_id",
    "first_representative_order": [
      "projected_euclidean_distance_to_centroid_ascending",
      "outside_query_union_true_first",
      "rrf_score_descending",
      "atom_id_ascending"
    ],
    "subsequent_representative_order": [
      "minimum_full_embedding_cosine_distance_to_selected_descending",
      "outside_query_union_true_first",
      "rrf_score_descending",
      "atom_id_ascending"
    ]
  },
  "stratification": {
    "split_proportions": {
      "train": 0.5,
      "dev": 0.17,
      "test": 0.33
    },
    "split_count_rounding": "largest_remainder_v1",
    "split_rounding_tie_break": [
      "train",
      "dev",
      "test"
    ],
    "participant_within_split_allocation": "eligible_share_largest_remainder_v1",
    "participant_rounding_tie_break": "participant_source_id_ascending",
    "modality_fraction_bounds": {
      "both": {
        "minimum": 0.5,
        "maximum": 0.7
      },
      "dense_caption_only": {
        "minimum": 0.2,
        "maximum": 0.35
      },
      "transcript_only": {
        "minimum": 0.08,
        "maximum": 0.15
      }
    },
    "fraction_bound_rounding": {
      "minimum": "ceil",
      "maximum": "floor"
    },
    "minimum_per_nonempty_source_group": 1,
    "maximum_per_source_group": 250
  },
  "audit_sampling": {
    "per_query_family": 50,
    "diversity_only": 50,
    "allocation_across_split": "selected_share_largest_remainder_v1",
    "sample_order": "sha256_selection_id_nul_family_nul_atom_id_ascending",
    "stratum_shortfall_policy": "select_all_available_without_blocking_and_report_shortfall",
    "human_precision_owner": "windows_t4_after_import"
  },
  "joint_solver": {
    "algorithm": "ortools_cp_sat_v1",
    "candidate_universe": "all_near_duplicate_survivors",
    "integer_variables": "one_boolean_per_survivor",
    "hard_constraints": [
      "core_count_exact",
      "split_counts_exact",
      "participant_within_split_counts_exact",
      "modality_fraction_bounds",
      "source_group_bounds",
      "cluster_bounds",
      "diversity_reservoir_minimums"
    ],
    "lexicographic_objectives": [
      "maximize_selected_query_union_count",
      "minimize_sum_global_retrieval_rank",
      "maximize_sum_diversity_reservoir_novelty_rank_utility",
      "minimize_sum_atom_id_ordinal"
    ],
    "objective_execution": "solve_each_objective_to_optimal_then_fix_value_before_next",
    "variable_order": "atom_id_ascending",
    "decision_strategy": "choose_first_select_max_value",
    "search_branching": "FIXED_SEARCH",
    "num_search_workers": 1,
    "random_seed": 20260910,
    "max_time_seconds_per_objective": 21600,
    "accepted_status": "OPTIMAL",
    "feasible_or_unknown_status_policy": "block_without_output",
    "repeat_final_fixed_objective_solve_count": 2,
    "repeatability_gate": "selected_atom_id_sha256_must_match_across_runs"
  },
  "conflict_policy": {
    "insufficient_minimum": "block_before_selection",
    "minimum_exceeds_maximum": "block_before_selection",
    "joint_constraints_infeasible": "block_without_relaxation",
    "core_count_shortfall": "block_without_duplicate_or_fallback",
    "extension_shortfall": "allowed_when_stop_rule_is_met_and_final_count_is_at_least_minimum_count",
    "constraint_processing_order": [
      "candidate_count",
      "split_proportions",
      "participant_within_split_allocation",
      "modality_fraction_bounds",
      "source_group_bounds",
      "semantic_cluster_bounds",
      "diversity_reservoir_minimums",
      "extension_novelty"
    ]
  },
  "ordering": {
    "retrieval_list": [
      "score_descending",
      "atom_id_ascending"
    ],
    "primary_query_attribution": [
      "rrf_score_descending",
      "best_rank_ascending",
      "query_family_order",
      "query_id_ascending"
    ],
    "coverage_deficit": [
      "available_to_required_ratio_ascending",
      "constraint_processing_order",
      "stratum_value_ascending"
    ],
    "global_retrieval_rank": [
      "query_union_true_first",
      "rrf_score_descending",
      "best_dense_rank_ascending",
      "best_sparse_rank_ascending",
      "canonical_cluster_id_ascending",
      "atom_id_ascending"
    ],
    "diversity_reservoir_novelty_rank": [
      "canonical_cluster_id_ascending",
      "reservoir_selection_sequence_ascending",
      "atom_id_ascending"
    ],
    "diversity_reservoir_novelty_rank_utility": "cluster_reservoir_size_minus_zero_based_reservoir_sequence_for_members_else_zero",
    "atom_id_ordinal": "one_based_rank_of_all_survivors_by_unicode_code_point_ascending",
    "core_candidate_choice": "joint_solver_lexicographic_solution",
    "extension_choice": [
      "eligible_cluster_size_ascending",
      "canonical_cluster_id_ascending",
      "minimum_full_embedding_cosine_distance_to_selected_descending",
      "rrf_score_descending",
      "atom_id_ascending"
    ],
    "proof_record_type_order": [
      "query_hit",
      "candidate",
      "cluster",
      "shard",
      "audit_sample"
    ],
    "proof_within_type_order": {
      "query_hit": "query_file_row_then_dense_before_sparse_then_rank",
      "candidate": "selection_sequence_ascending",
      "cluster": "canonical_cluster_id_ascending",
      "shard": "shard_index_ascending",
      "audit_sample": "query_family_order_then_diversity_only_then_sample_index"
    },
    "formal_output": [
      "atom_id_ascending"
    ]
  }
}
