{
  "schema_version": "bge_model_config_v2",
  "repository": "BAAI/bge-m3",
  "revision": "5617a9f61b028005a4858fdac845db406aefb181",
  "device": "cuda:0",
  "precision": "fp16",
  "max_length": 512,
  "encode_batch_size": 4,
  "query_batch_size": 16,
  "dataloader_workers": 2,
  "encoding_shard_size": 4096,
  "return_dense": true,
  "return_sparse": true,
  "return_colbert_vecs": false,
  "dense_output_dtype": "float32",
  "dense_l2_normalize": true,
  "sparse_storage": "scipy_csr_npz_v1",
  "passage_builder": {
    "version": "single_raw_passage_v3",
    "encoding_mode": "one_atom_one_model_input_string",
    "field_order": [
      "transcript",
      "dense_caption"
    ],
    "include_field_if": "json_string_with_length_gt_zero",
    "null_field_policy": "omit",
    "line_prefixes": {
      "transcript": "transcript: ",
      "dense_caption": "dense_caption: "
    },
    "line_separator": "\n",
    "append_final_newline": false,
    "text_transform_before_model": "none_preserve_unicode_code_points",
    "visible_text_policy": "validate_exact_derivation_then_never_encode"
  },
  "query_text_transform_before_model": "none_use_exact_json_string"
}
