{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egopm-bench.local/schema/v1.0.0/cue_inference_batch_v1.schema.json",
  "title": "EgoPM-Bench v1 Cue Inference Batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_index", "entities", "scene_type", "activity_type", "cue_type", "normalized_predicate", "supporting_text_span", "confidence", "ambiguity_reason", "validation_status"],
      "properties": {
        "item_index": {"type": "integer", "minimum": 0, "maximum": 4},
        "entities": {"type": "array", "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 64}, "uniqueItems": true},
        "scene_type": {"type": ["string", "null"], "maxLength": 64},
        "activity_type": {"type": ["string", "null"], "maxLength": 64},
        "cue_type": {"enum": ["time", "person", "place", "object", "activity", "state_change"]},
        "normalized_predicate": {"$ref": "#/$defs/predicate"},
        "supporting_text_span": {"type": "string", "minLength": 1, "maxLength": 256},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "ambiguity_reason": {"type": ["string", "null"], "maxLength": 128},
        "validation_status": {"enum": ["accepted", "rejected", "needs_review"]}
      }
    },
    "predicate_clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "operator", "value"],
      "properties": {
        "slot": {"enum": ["time", "person", "place", "object", "activity", "state_change"]},
        "operator": {"enum": ["eq", "not_eq", "present", "absent", "starts", "ends", "contains"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_of"],
      "properties": {
        "all_of": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/predicate_clause"}},
        "any_of": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/predicate_clause"}}
      }
    }
  }
}
