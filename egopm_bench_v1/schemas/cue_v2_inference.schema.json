{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egopm-bench.local/schema/cue-v2-inference-current.json",
  "title": "Cue v2 推理输出",
  "type": "object",
  "additionalProperties": false,
  "required": ["items"],
  "properties": {"items": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/item"}}},
  "$defs": {
    "evidence": {"type": "object", "additionalProperties": false, "required": ["field", "span"], "properties": {"field": {"enum": ["transcript", "dense_caption"]}, "span": {"type": "string", "minLength": 1}}},
    "anchor": {"type": "object", "additionalProperties": false, "required": ["role", "value"], "properties": {"role": {"enum": ["observed_object", "state_bearer", "holder", "activity_bearer", "located_entity", "person"]}, "value": {"type": "string", "minLength": 1}}},
    "clause": {
      "type": "object", "additionalProperties": false,
      "required": ["dimension", "operator", "anchor", "value", "evidence"],
      "properties": {
        "dimension": {"enum": ["person", "location", "object", "activity", "state", "explicit_time"]},
        "operator": {"enum": ["present", "absent", "speaking", "mentioned", "at", "not_at", "entering", "leaving", "held", "placed", "starts", "ongoing", "ends", "not_occurring", "is", "is_not", "changes_to", "stated", "planned", "hypothetical"]},
        "anchor": {"$ref": "#/$defs/anchor"}, "value": {"type": "string", "minLength": 1}, "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "predicate": {"type": "object", "additionalProperties": false, "required": ["all_of"], "properties": {"all_of": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/clause"}}}},
    "accepted": {"type": "object", "additionalProperties": false, "required": ["item_index", "disposition", "predicate", "reason_codes"], "properties": {"item_index": {"type": "integer", "minimum": 0, "maximum": 4}, "disposition": {"const": "accepted_cue"}, "predicate": {"$ref": "#/$defs/predicate"}, "reason_codes": {"type": "array", "maxItems": 0}}},
    "non_accepted": {"type": "object", "additionalProperties": false, "required": ["item_index", "disposition", "reason_codes"], "properties": {"item_index": {"type": "integer", "minimum": 0, "maximum": 4}, "disposition": {"enum": ["no_cue", "ambiguous", "unsupported"]}, "reason_codes": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "minLength": 1}}}},
    "item": {"oneOf": [{"$ref": "#/$defs/accepted"}, {"$ref": "#/$defs/non_accepted"}]}
  }
}
