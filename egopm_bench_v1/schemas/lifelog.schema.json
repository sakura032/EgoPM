{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egopm-bench.local/schema/v1.0.0/lifelog.schema.json",
  "title": "EgoPM-Bench v1 Life Log",
  "type": "object",
  "additionalProperties": false,
  "required": ["lifelog_id", "family_id", "seed_id", "split", "counterfactual_branch", "difficulty", "referenced_source_seconds", "event_count", "events"],
  "properties": {
    "lifelog_id": {"type": "string", "pattern": "^log_[A-Za-z0-9_]+$"},
    "family_id": {"type": "string", "pattern": "^family_[A-Za-z0-9_]+$"},
    "seed_id": {"type": "string", "pattern": "^seed_[A-Za-z0-9_]+$"},
    "split": {"enum": ["train", "dev", "test"]},
    "counterfactual_branch": {"enum": ["positive", "negative"]},
    "difficulty": {"enum": ["short", "medium", "long"]},
    "referenced_source_seconds": {"type": "number", "minimum": 0},
    "event_count": {"type": "integer", "minimum": 1},
    "events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "source_paths": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["transcript", "dense_caption"],
      "properties": {
        "transcript": {"type": ["string", "null"]},
        "dense_caption": {"type": ["string", "null"]}
      }
    },
    "source_time": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["local_start_sec", "local_end_sec", "normalized_start_sec", "normalized_end_sec"],
      "properties": {
        "local_start_sec": {"type": "number", "minimum": 0},
        "local_end_sec": {"type": "number", "exclusiveMinimum": 0},
        "normalized_start_sec": {"type": "number", "minimum": 0},
        "normalized_end_sec": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "event_position", "virtual_time", "source_time", "atom_id", "event_kind", "visible_text", "source_srt_paths", "source_video_path", "video_mapping_status", "rule_id", "intention_state_before", "intention_state_after", "event_role", "provenance"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^evt_[A-Za-z0-9_]+$"},
        "event_position": {"type": "integer", "minimum": 0},
        "virtual_time": {"type": "string", "pattern": "^D[0-9]{2} [0-2][0-9]:[0-5][0-9](?::[0-5][0-9])?$"},
        "source_time": {"$ref": "#/$defs/source_time"},
        "atom_id": {"type": ["string", "null"], "pattern": "^src_[A-Za-z0-9_]+$"},
        "event_kind": {"enum": ["source_video_atom", "constructed_intention", "constructed_observation"]},
        "visible_text": {"type": "string", "minLength": 1},
        "source_srt_paths": {"$ref": "#/$defs/source_paths"},
        "source_video_path": {"type": ["string", "null"]},
        "video_mapping_status": {"enum": ["pending", "verified", "unavailable", "not_applicable"]},
        "rule_id": {"type": ["string", "null"], "pattern": "^rule_[A-Za-z0-9_]+$"},
        "intention_state_before": {"enum": ["active_unreminded", "active_reminded", "completed", "cancelled", "expired", null]},
        "intention_state_after": {"enum": ["active_unreminded", "active_reminded", "completed", "cancelled", "expired", null]},
        "event_role": {"enum": ["intention_creation", "intention_revision", "intention_cancelled", "intention_expired", "trigger", "lure", "background", "intention_execution", "intention_completed", "reminder_history"]},
        "provenance": {"enum": ["egolife_srt", "constructed_intention", "constructed_observation"]}
      },
      "allOf": [
        {"if": {"properties": {"event_kind": {"const": "source_video_atom"}}}, "then": {"properties": {"atom_id": {"type": "string"}, "source_time": {"type": "object"}, "source_srt_paths": {"type": "object"}, "rule_id": {"type": "null"}, "provenance": {"const": "egolife_srt"}}}},
        {"if": {"properties": {"event_kind": {"enum": ["constructed_intention", "constructed_observation"]}}}, "then": {"properties": {"atom_id": {"type": "null"}, "source_time": {"type": "null"}, "source_srt_paths": {"type": "null"}, "source_video_path": {"type": "null"}, "video_mapping_status": {"const": "not_applicable"}, "rule_id": {"type": "string"}}}}
      ]
    }
  }
}
