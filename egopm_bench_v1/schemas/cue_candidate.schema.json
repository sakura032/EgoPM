{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egopm-bench.local/schema/v1.0.0/cue_candidate.schema.json",
  "title": "EgoPM-Bench v1 Cue Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["cue_id", "atom_id", "split", "entities", "scene_type", "activity_type", "cue_type", "normalized_predicate", "supporting_text_span", "source_text", "confidence", "ambiguity_reason", "model_id", "prompt_version", "schema_version", "run_id", "validation_status"],
  "properties": {
    "cue_id": {"type": "string", "pattern": "^cue_[A-Za-z0-9_]+$"},
    "atom_id": {"type": "string", "pattern": "^src_[A-Za-z0-9_]+$"},
    "split": {"enum": ["train", "dev", "test"]},
    "entities": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "scene_type": {"type": ["string", "null"]},
    "activity_type": {"type": ["string", "null"]},
    "cue_type": {"enum": ["time", "person", "place", "object", "activity", "state_change"]},
    "normalized_predicate": {"$ref": "#/$defs/predicate"},
    "supporting_text_span": {"type": "string", "minLength": 1},
    "source_text": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "ambiguity_reason": {"type": ["string", "null"]},
    "model_id": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "schema_version": {"const": "v1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "validation_status": {"enum": ["accepted", "rejected", "needs_review"]},
    "validation_errors": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "predicate_clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "operator", "value"],
      "properties": {
        "slot": {"enum": ["time", "person", "place", "object", "activity", "state_change"]},
        "operator": {"enum": ["eq", "not_eq", "present", "absent", "starts", "ends", "contains"]},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_of"],
      "properties": {
        "all_of": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/predicate_clause"}},
        "any_of": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/predicate_clause"}}
      }
    }
  }
}
