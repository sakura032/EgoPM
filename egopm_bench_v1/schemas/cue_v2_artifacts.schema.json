{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egopm-bench.local/schema/cue-v2-row-current.json",
  "title": "Cue v2 当前运行行",
  "oneOf": [{"$ref": "#/$defs/accepted"}, {"$ref": "#/$defs/non_accepted"}],
  "$defs": {
    "evidence": {"type": "object", "additionalProperties": false, "required": ["field", "span"], "properties": {"field": {"enum": ["transcript", "dense_caption"]}, "span": {"type": "string", "minLength": 1}}},
    "anchor": {"type": "object", "additionalProperties": false, "required": ["role", "value"], "properties": {"role": {"enum": ["observed_object", "state_bearer", "holder", "activity_bearer", "located_entity", "person"]}, "value": {"type": "string", "minLength": 1}}},
    "clause": {"type": "object", "additionalProperties": false, "required": ["dimension", "operator", "anchor", "value", "evidence"], "properties": {"dimension": {"enum": ["person", "location", "object", "activity", "state", "explicit_time"]}, "operator": {"type": "string", "minLength": 1}, "anchor": {"$ref": "#/$defs/anchor"}, "value": {"type": "string", "minLength": 1}, "evidence": {"$ref": "#/$defs/evidence"}}},
    "predicate": {"type": "object", "additionalProperties": false, "required": ["all_of"], "properties": {"all_of": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/clause"}}}},
    "base": {"type": "object", "properties": {"run_id": {"type": "string", "minLength": 1}, "atom_id": {"type": "string", "minLength": 1}, "status": {"enum": ["accepted", "no_cue", "needs_review", "deferred_unsupported", "invalid_output", "transport_error"]}, "attempt": {"type": "integer", "minimum": 1}, "model_id": {"type": "string", "minLength": 1}, "reason_codes": {"type": "array", "items": {"type": "string", "minLength": 1}}}, "required": ["run_id", "atom_id", "status", "attempt", "model_id", "reason_codes"]},
    "accepted": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {
          "type": "object",
          "required": ["cue"],
          "properties": {
            "cue": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cue_id", "predicate"],
              "properties": {
                "cue_id": {"type": "string", "pattern": "^cue_[A-Za-z0-9_-]+$"},
                "predicate": {"$ref": "#/$defs/predicate"}
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "non_accepted": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "not": {"required": ["cue"]}}], "unevaluatedProperties": false}
  }
}
