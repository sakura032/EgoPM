{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egopm-bench.local/schema/v1.1.0/trigger_lure_set.schema.json",
  "title": "EgoPM-Bench v1 BGE-M3 trigger/lure set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "retrieval_id",
    "cue_id",
    "trigger_cue_id",
    "trigger_atom_id",
    "split",
    "source_group_id",
    "lure_atom_ids",
    "lure_audit",
    "retrieval_method",
    "model_id",
    "model_revision",
    "channel_top_k",
    "rrf_k",
    "query_serialization_version",
    "passage_serialization_version",
    "retrieval_parameters_sha256",
    "source_atoms_sha256",
    "cue_manifest_sha256",
    "run_id",
    "schema_version"
  ],
  "properties": {
    "retrieval_id": {"type": "string", "pattern": "^retrieval_[A-Za-z0-9_]+$"},
    "cue_id": {"type": "string", "pattern": "^cue_[A-Za-z0-9_]+$"},
    "trigger_cue_id": {"type": "string", "pattern": "^cue_[A-Za-z0-9_]+$"},
    "trigger_atom_id": {"type": "string", "pattern": "^src_[A-Za-z0-9_]+$"},
    "split": {"type": "string", "enum": ["train", "dev", "test"]},
    "source_group_id": {"type": "string", "minLength": 1},
    "lure_atom_ids": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^src_[A-Za-z0-9_]+$"}
    },
    "lure_audit": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "atom_id",
          "source_group_id",
          "group_relation",
          "unsatisfied_predicate_clause_indexes",
          "rank_dense",
          "rank_sparse",
          "rrf_score"
        ],
        "properties": {
          "atom_id": {"type": "string", "pattern": "^src_[A-Za-z0-9_]+$"},
          "source_group_id": {"type": "string", "minLength": 1},
          "group_relation": {"type": "string", "enum": ["same_source_group", "different_source_group"]},
          "unsatisfied_predicate_clause_indexes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 0}
          },
          "rank_dense": {"type": ["integer", "null"], "minimum": 1},
          "rank_sparse": {"type": ["integer", "null"], "minimum": 1},
          "rrf_score": {"type": "number", "minimum": 0}
        }
      }
    },
    "retrieval_method": {"const": "bge_m3_hybrid_rrf_v1"},
    "model_id": {"const": "BAAI/bge-m3"},
    "model_revision": {"const": "5617a9f61b028005a4858fdac845db406aefb181"},
    "channel_top_k": {"const": 64},
    "rrf_k": {"const": 60},
    "query_serialization_version": {"const": "cue_query_v1"},
    "passage_serialization_version": {"const": "atom_passage_v1"},
    "retrieval_parameters_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_atoms_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cue_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "schema_version": {"const": "v1.1.0"}
  }
}
