{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egopm-bench.local/schema/v1.0.0/decision_instance.schema.json",
  "title": "EgoPM-Bench v1 Decision Instance",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision_id", "lifelog_id", "family_id", "split", "target_intention_id", "decision_type", "counterfactual_pair_id", "difficulty", "model_input", "valid_window", "gold_action", "oracle_annotation", "evidence_support_groups"],
  "properties": {
    "decision_id": {"type": "string", "pattern": "^dec_[A-Za-z0-9_]+$"},
    "lifelog_id": {"type": "string", "pattern": "^log_[A-Za-z0-9_]+$"},
    "family_id": {"type": "string", "pattern": "^family_[A-Za-z0-9_]+$"},
    "split": {"enum": ["train", "dev", "test"]},
    "target_intention_id": {"type": "string", "pattern": "^int_[A-Za-z0-9_]+$"},
    "decision_type": {"enum": ["trigger", "non_trigger_lure", "post_completion_lure", "post_cancellation_lure", "post_expiry_lure", "already_reminded_lure", "ordinary_silence"]},
    "counterfactual_pair_id": {"type": "string", "pattern": "^cf_[A-Za-z0-9_]+$"},
    "difficulty": {"enum": ["short", "medium", "long"]},
    "model_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stream_position", "current_event_id", "virtual_time", "visible_text"],
      "properties": {
        "stream_position": {"type": "integer", "minimum": 0},
        "current_event_id": {"type": "string", "pattern": "^evt_[A-Za-z0-9_]+$"},
        "virtual_time": {"type": "string", "pattern": "^D[0-9]{2} [0-2][0-9]:[0-5][0-9](?::[0-5][0-9])?$"},
        "visible_text": {"type": "string", "minLength": 1}
      }
    },
    "valid_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_virtual_time", "end_virtual_time"],
      "properties": {
        "start_virtual_time": {"type": "string", "pattern": "^D[0-9]{2} [0-2][0-9]:[0-5][0-9](?::[0-5][0-9])?$"},
        "end_virtual_time": {"type": "string", "pattern": "^D[0-9]{2} [0-2][0-9]:[0-5][0-9](?::[0-5][0-9])?$"}
      }
    },
    "gold_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "intention_ids"],
      "properties": {
        "kind": {"enum": ["silent", "remind"]},
        "intention_ids": {"type": "array", "items": {"type": "string", "pattern": "^int_[A-Za-z0-9_]+$"}, "uniqueItems": true}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "silent"}}}, "then": {"properties": {"intention_ids": {"maxItems": 0}}}},
        {"if": {"properties": {"kind": {"const": "remind"}}}, "then": {"properties": {"intention_ids": {"minItems": 1}}}}
      ]
    },
    "oracle_annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_before", "state_after", "rule_id"],
      "properties": {
        "state_before": {"enum": ["active_unreminded", "active_reminded", "completed", "cancelled", "expired", "never_created"]},
        "state_after": {"enum": ["active_unreminded", "active_reminded", "completed", "cancelled", "expired", "never_created"]},
        "rule_id": {"type": "string", "pattern": "^rule_[A-Za-z0-9_]+$"}
      }
    },
    "evidence_support_groups": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence_group"}
    }
  },
  "$defs": {
    "evidence_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support_group_id", "items"],
      "properties": {
        "support_group_id": {"type": "string", "pattern": "^eg_[A-Za-z0-9_]+$"},
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event_id", "role", "necessity"],
            "properties": {
              "event_id": {"type": "string", "pattern": "^evt_[A-Za-z0-9_]+$"},
              "role": {"enum": ["intention_definition", "trigger_condition", "state_invalidation", "reminder_history", "distractor_exclusion"]},
              "necessity": {"enum": ["essential", "supporting", "redundant", "distractor"]}
            }
          }
        }
      }
    }
  }
}
