{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egopm-bench.local/schema/v1.0.0/reminder_seed.schema.json",
  "title": "EgoPM-Bench v1 Reminder Seed",
  "type": "object",
  "additionalProperties": false,
  "required": ["seed_id", "family_id", "split", "source_group_id", "intention", "primary_cue_type", "trigger_atom_id", "lure_atom_ids", "trigger_predicate", "valid_window", "terminal_silent_conditions", "counterfactual_negative_type", "rule_ids", "current_trigger_leakage_checked", "audit", "generation_record"],
  "properties": {
    "seed_id": {"type": "string", "pattern": "^seed_[A-Za-z0-9_]+$"},
    "family_id": {"type": "string", "pattern": "^family_[A-Za-z0-9_]+$"},
    "split": {"enum": ["train", "dev", "test"]},
    "source_group_id": {"type": "string", "minLength": 1},
    "intention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intention_id", "action_content"],
      "properties": {
        "intention_id": {"type": "string", "pattern": "^int_[A-Za-z0-9_]+$"},
        "action_content": {"type": "string", "minLength": 1}
      }
    },
    "primary_cue_type": {"enum": ["time", "person", "place", "object", "activity", "state_change"]},
    "trigger_atom_id": {"type": "string", "pattern": "^src_[A-Za-z0-9_]+$"},
    "lure_atom_ids": {"type": "array", "minItems": 2, "items": {"type": "string", "pattern": "^src_[A-Za-z0-9_]+$"}, "uniqueItems": true},
    "trigger_predicate": {"$ref": "#/$defs/predicate"},
    "valid_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_to", "start_offset_sec", "end_offset_sec"],
      "properties": {
        "relative_to": {"const": "trigger_event"},
        "start_offset_sec": {"type": "number", "minimum": 0},
        "end_offset_sec": {"type": "number", "minimum": 0}
      }
    },
    "terminal_silent_conditions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["completed", "cancelled", "expired", "already_reminded"]}},
    "counterfactual_negative_type": {"enum": ["never_created", "completed", "cancelled", "expired", "already_reminded"]},
    "rule_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^rule_[A-Za-z0-9_]+$"}, "uniqueItems": true},
    "current_trigger_leakage_checked": {"type": "boolean"},
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "human_reviewer"],
      "properties": {
        "status": {"enum": ["candidate", "accept", "revise", "reject"]},
        "reason": {"type": "string", "minLength": 1},
        "human_reviewer": {"type": ["string", "null"]},
        "model_audit_run_id": {"type": ["string", "null"]}
      }
    },
    "generation_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "model_id", "prompt_version", "schema_version"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "prompt_version": {"type": "string", "minLength": 1},
        "schema_version": {"const": "v1.0.0"}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"audit": {"properties": {"status": {"const": "accept"}}}}}, "then": {"properties": {"audit": {"properties": {"human_reviewer": {"type": "string", "minLength": 1}}}}}},
    {"properties": {"valid_window": {"properties": {"end_offset_sec": {"minimum": 0}}}}}
  ],
  "$defs": {
    "predicate_clause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "operator", "value"],
      "properties": {
        "slot": {"enum": ["time", "person", "place", "object", "activity", "state_change"]},
        "operator": {"enum": ["eq", "not_eq", "present", "absent", "starts", "ends", "contains"]},
        "value": {"type": "string", "minLength": 1}
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_of"],
      "properties": {
        "all_of": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/predicate_clause"}},
        "any_of": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/predicate_clause"}}
      }
    }
  }
}
