# Secrets and environment-specific credentials
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json

# Read-only source corpora and media must never enter this repository.
raw/
Egolife/
*.mp4
*.mov
*.avi
*.mkv
*.wav
*.mp3

# 正式 Source 派生产物保留本机，以 SUCCESS 哈希追溯，不进入代码仓库。
egopm_bench_v1/source/raw_srt_segments.jsonl
egopm_bench_v1/source/source_split_map.jsonl
egopm_bench_v1/source/source_video_atoms.jsonl
egopm_bench_v1/source/source_video_atoms_draft.jsonl
.local_source_backup/

# Model raw responses can contain third-party text and must remain local.
egopm_bench_v1/logs/model_runs/**

# 每次正式 Batch 运行的审批文件含预算和负责人信息，只留本机且不含密钥。
egopm_bench_v1/cues/CUE_EXECUTION_AUTHORIZATION.json
egopm_bench_v1/cues/batch/
egopm_bench_v1/cues/realtime/

# Atomic-production intermediates and local caches
*.tmp
*.tmp.*
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
*.egg-info/

# OS/editor files
