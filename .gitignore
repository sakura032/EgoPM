# 密钥与本机凭据
.env
.env.*
!.env.example
*.pem
*.key
*credentials*.json

# 只读语料与媒体，绝不进入仓库
raw/
Egolife/
*.mp4
*.mov
*.avi
*.mkv
*.wav
*.mp3

# 正式 Source 派生产物保留本机，不进入代码仓库
egopm_bench_v1/source/raw_srt_segments.jsonl
egopm_bench_v1/source/source_split_map.jsonl
egopm_bench_v1/source/source_video_atoms.jsonl
egopm_bench_v1/source/source_video_atoms_draft.jsonl
.local_source_backup/

# Cue 阶段：selected_atoms.jsonl 含 EgoLife 原文，结果与 checkpoint 属本机数据
egopm_bench_v1/cues/inputs/*.jsonl
egopm_bench_v1/cues/runs/

# 模型原始响应含第三方文本，只能留在本机
egopm_bench_v1/logs/

